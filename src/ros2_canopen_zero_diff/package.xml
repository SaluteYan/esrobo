<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>zero_diff_canopen_driver</name>
  <version>0.0.1</version>
  <description>CANopen driver for Zero Difference Joint Modules using ros2_canopen</description>
  <maintainer email="user@example.com">User</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 核心依赖 -->
  <depend>rclcpp</depend>
  <depend>canopen_core</depend>
  <depend>canopen_402_driver</depend>
  <depend>canopen_ros2_control</depend>
  
  <!-- ros2_control 相关依赖 -->
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp_lifecycle</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

